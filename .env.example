# trainex-sync – Konfiguration
# Kommentare nur in eigenen Zeilen (systemd erlaubt keine Kommentare hinter Werten).
# Passwörter mit Sonderzeichen in einfache Anführungszeichen setzen: TRAINEX_PASS='a$b#c'

# ── TraiNex-Login ──
TRAINEX_USER=
TRAINEX_PASS=

# ── Telegram ──
# Token von @BotFather
TELEGRAM_BOT_TOKEN=
# Deine Telegram-User-ID: nur von dieser ID werden Befehle angenommen
TELEGRAM_ADMIN_ID=
# Optionaler Fallback-Kanal (beginnt mit -100…). Einfacher: nach dem Start /addchannel
# direkt im Kanal posten (Bot muss dort Admin sein) – dann wird dieser Wert ignoriert.
TELEGRAM_CHANNEL_ID=

# ── Kalender-Abo ──
# Geheimer Teil der Abo-URL (wird von install.sh erzeugt)
ICS_TOKEN=
PUBLIC_URL=https://tillianbo.com/trainex
CAL_NAME=HMU Stundenplan

# ── Zeitplan ──
# Startwert für das Intervall in Minuten (danach per /settime änderbar)
DEFAULT_INTERVAL=30
# Keine automatischen Läufe in dieser Zeit (leer = immer). Format: Start-Ende in Stunden
QUIET_HOURS=22-6

# ── Fehlzeiten (/modules) ──
# Erlaubte Fehlzeit in Prozent der Minuten – gilt je Modul und Veranstaltungsart
# (Vorlesung, Seminar, Praktikum … haben jeweils ein eigenes Budget)
ABSENCE_LIMIT=20

# ── Unterlagen (Lernen → Archiv) ──
# Neue, geänderte und entfernte Dokumente im selben Lauf wie der Stundenplan abgleichen und in den Kanal posten.
# 0 = aus
DOCS=1
# Semester im Filter „Nur Semester“. Leer = automatisch das Semester, dessen Zeitraum heute enthält
# (wechselt also von selbst zum nächsten Semester). Fest einstellen z. B. mit DOCS_SEMESTER=3
DOCS_SEMESTER=
# Dateien über dieser Größe (MB) werden nicht geladen, nur gemeldet. Telegram nimmt höchstens 50 MB.
DOCS_MAX_MB=100
# Nur falls die Archiv-Seite nicht automatisch gefunden wird: Pfad aus „sudo ./install.sh debug“
# DOCS_URL=cfm/archiv/archiv.cfm

# ── Ort ──
# Koordinaten des Campus für die Karte im Kalender („Breite,Länge“, z. B. aus Apple/Google Maps kopiert).
# Leer = automatisch einmalig über OpenStreetMap ermitteln.
CAMPUS_GEO=
